# Sample environment variables for chapter code
# Copy this file into the chapter folder and fill values:
#   cp code/.env.example code/chapter_01/.env
# Do NOT commit your real .env files containing secrets.

# OpenAI API key (required)
OPENAI_API_KEY=

# Optional: model to use (override default in code)
# Example: gpt-4.1-nano-2025-04-14
MODEL_NAME=gpt-4.1-nano-2025-04-14

# Optional: other secrets
OTHER_SECRET=
